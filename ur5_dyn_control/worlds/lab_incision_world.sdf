<!-- lab_incision_world.sdf — escena de la INCISION (Journal Q2).

     Igual que lab_torque_world.sdf SALVO que NO lleva el obstaculo: esa caja
     AABB pertenece al caso de uso de pick & place (replica
     pick_place_params.yaml) y no tiene ningun papel en el corte. Ningun codigo
     de control por torque la referencia.

     Se retira porque en la FASE 8 el brazo se desvia mucho (desajuste de
     modelo +-50 %, carga de 4 kg): un obstaculo ajeno al experimento podria
     provocar una colision que contaminara los resultados. En la trayectoria
     nominal la holgura medida era de 0.150 m, asi que las campanas anteriores
     NO estan afectadas.

     lab_torque_world.sdf se conserva intacto para reproducir esas campanas.

     2026-10-27: pedestal y mesa sustituidos por los modelos medidos sobre los
     reales (meshes/ur5_mounting_base y meshes/u_table de ESTE paquete, cotas en
     ur5_base_table_dimensions.pdf). Los anteriores (model://ur5_base y
     model://surgery_table de ur5_pick_place) estaban desactualizados:
       pedestal  900 x 900 x 630  ->  752 x 752 x 816 mm
       mesa      tablero a 630    ->  tablero a 770 mm, U de 2205 x 1800
     Consecuencias: el robot spawnea a z = 0.816 (no 0.63), y el tablero queda
     46 mm POR DEBAJO de la base del robot (z = -0.046 en base_link), cuando
     antes estaba enrasado con ella. Ambos modelos colisionan con cajas, no con
     la malla (ver la cabecera de cada model.sdf). -->
<sdf version='1.9'>
  <!-- Derivado de ur5_pick_place/worlds/lab_base_world.sdf con fisica a 1 kHz
       (paso 1 ms) para control por torque. Contenido: pedestal, mesa en U,
       sun, gravedad -9.8. -->
  <world name='default'>
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000.0</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>
    <plugin name='gz::sim::systems::Physics' filename='gz-sim-physics-system'/>
    <plugin name='gz::sim::systems::UserCommands' filename='gz-sim-user-commands-system'/>
    <plugin name='gz::sim::systems::SceneBroadcaster' filename='gz-sim-scene-broadcaster-system'/>
    <plugin name='gz::sim::systems::Contact' filename='gz-sim-contact-system'/>
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>
    <atmosphere type='adiabatic'/>
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>true</shadows>
    </scene>
    <audio>
      <device>default</device>
    </audio>
    <model name='ground_plane'>
      <static>true</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode/>
            </friction>
            <bounce/>
            <contact/>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <material>
              <ambient>0.031 0.043 0.1 1</ambient>
              <diffuse>0.031 0.043 0.1 1</diffuse>
              <specular>0.031 0.043 0.1 1</specular>
          </material>
        </visual>
        <pose>0 0 0 0 -0 0</pose>
        <inertial>
          <pose>0 0 0 0 -0 0</pose>
          <mass>1</mass>
          <inertia>
            <ixx>1</ixx>
            <ixy>0</ixy>
            <ixz>0</ixz>
            <iyy>1</iyy>
            <iyz>0</iyz>
            <izz>1</izz>
          </inertia>
        </inertial>
        <enable_wind>false</enable_wind>
      </link>
      <pose>0 0 0 0 -0 0</pose>
      <self_collide>false</self_collide>
    </model>


    <!-- Pedestal real del UR5e (752 x 752 x 816 mm), centrado en el origen. El
         robot spawnea encima, a z = 0.816 (launch/world_defaults.py). -->
    <include>
      <uri>model://ur5_mounting_base</uri>
      <name>ur5_mounting_base</name>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <!-- Mesa de trabajo real en U, con el pedestal metido en la abertura de la
         U. El origen del modelo es el borde interior del fondo de la U (el que
         mira al robot), en el suelo, asi que x es la distancia del eje del robot
         a ese borde. x = 0.426 = 0.376 (medio pedestal) + 0.050, la holgura
         MEDIDA en el laboratorio (2026-10-27) entre la cara del pedestal y la
         mesa. Lateralmente centrado: 0.1265 m a cada lado. Si en el laboratorio
         se mueve la mesa, se cambia esta x; no puede bajar de 0.376. -->
    <include>
      <uri>model://u_table</uri>
      <name>u_table</name>
      <pose>0.426 0 0 0 0 0</pose>
    </include>


    <light name='sun' type='directional'>
      <pose>0 0 10 0 -0 0</pose>
      <cast_shadows>true</cast_shadows>
      <intensity>1.5</intensity>
      <direction>-0.5 0.5 -1</direction>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <linear>0.01</linear>
        <constant>0.90000000000000002</constant>
        <quadratic>0.001</quadratic>
      </attenuation>
      <spot>
        <inner_angle>0</inner_angle>
        <outer_angle>0</outer_angle>
        <falloff>0</falloff>
      </spot>
    </light>
  </world>
</sdf>
