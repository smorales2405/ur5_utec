<?xml version="1.0"?>
<!--
  UR5e arm only, con interfaz de comando EFFORT, para control por torque en
  Gazebo Fortress / ROS 2 Humble. Sin gripper Robotiq, pero manteniendo el
  frame 'gripper_tcp' a 0.141 m de tool0 (misma cadena que
  ur5_robotiq_2f85.urdf.xacro — ver ur5_pick_place/urdf/ur5e.urdf.xacro).

  Diferencias respecto a ur5e.urdf.xacro de ur5_pick_place:
   - xacro:ur_robot se instancia con generate_ros2_control_tag="false"
     (el macro estandar suprime la command interface 'effort' cuando
     sim_ignition=true).
   - El bloque <ros2_control> lo aporta ur5e_effort.ros2_control.xacro:
     command interfaces position + effort por joint, initial_value desde
     initial_positions_file (pose inicial de todos los nodos dinamicos).
-->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="ur5e">

  <!-- ===== Arguments ===== -->
  <xacro:arg name="name"    default="ur"/>
  <xacro:arg name="ur_type" default="ur5e"/>

  <xacro:arg name="tf_prefix"               default=""/>
  <xacro:arg name="joint_limit_params"      default="$(find ur_description)/config/$(arg ur_type)/joint_limits.yaml"/>
  <xacro:arg name="kinematics_params"       default="$(find ur_description)/config/$(arg ur_type)/default_kinematics.yaml"/>
  <xacro:arg name="physical_params"         default="$(find ur_description)/config/$(arg ur_type)/physical_parameters.yaml"/>
  <xacro:arg name="visual_params"           default="$(find ur_description)/config/$(arg ur_type)/visual_parameters.yaml"/>
  <xacro:arg name="safety_limits"           default="false"/>
  <xacro:arg name="safety_pos_margin"       default="0.15"/>
  <xacro:arg name="safety_k_position"       default="20"/>
  <xacro:arg name="initial_positions_file"  default="$(find ur5_dyn_control)/config/initial_positions.yaml"/>
  <xacro:arg name="simulation_controllers"  default=""/>

  <!-- ===== Includes ===== -->
  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find ur5_dyn_control)/urdf/ur5e_effort.ros2_control.xacro"/>

  <!-- ===== Properties ===== -->
  <xacro:property name="initial_positions_file" value="$(arg initial_positions_file)"/>

  <!-- ===== World link ===== -->
  <link name="world"/>

  <!-- ===== UR5e robot arm (sin bloque ros2_control del macro estandar) ===== -->
  <xacro:ur_robot
    name="$(arg name)"
    tf_prefix="$(arg tf_prefix)"
    parent="world"
    joint_limits_parameters_file="$(arg joint_limit_params)"
    kinematics_parameters_file="$(arg kinematics_params)"
    physical_parameters_file="$(arg physical_params)"
    visual_parameters_file="$(arg visual_params)"
    safety_limits="$(arg safety_limits)"
    safety_pos_margin="$(arg safety_pos_margin)"
    safety_k_position="$(arg safety_k_position)"
    generate_ros2_control_tag="false"
    sim_ignition="true">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <!-- ===== ros2_control con interfaz effort ===== -->
  <xacro:ur5e_effort_ros2_control
    name="ur5e_effort_system"
    tf_prefix="$(arg tf_prefix)"
    initial_positions="${xacro.load_yaml(initial_positions_file)}"/>

  <!-- ===== Gazebo plugin (gz_ros2_control) ===== -->
  <!-- IMPORTANTE: usar los nombres modernos gz_ros2_control (como el paquete
       open_manipulator_x_torque_control, verificado con effort en esta
       maquina) y NO los alias legacy libign_ros2_control-system.so /
       IgnitionROS2ControlPlugin de ur5_pick_place: con esos alias la
       actuacion por effort no funciona (verificado empiricamente). -->
  <gazebo reference="world"/>
  <gazebo>
    <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <parameters>$(arg simulation_controllers)</parameters>
      <controller_manager_node_name>$(arg tf_prefix)controller_manager</controller_manager_node_name>
    </plugin>
  </gazebo>

  <!-- ===== gripper_tcp frame ===== -->
  <!-- Frame fijo a 0.141 m de tool0 en Z local (offset combinado adaptador +
       gripper). Identico al gripper_tcp de ur5_robotiq_2f85.urdf.xacro:
       mantiene la pose TCP del gripper aunque el modelo no lo lleve. -->
  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <parent link="$(arg tf_prefix)tool0"/>
    <child  link="gripper_tcp"/>
    <origin xyz="0 0 0.141" rpy="0 0 0"/>
  </joint>

</robot>
