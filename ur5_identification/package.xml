<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ur5_identification</name>
  <version>0.1.0</version>
  <description>
    Identificacion offline de friccion articular del UR5e (FASE 2 del plan de
    incision). Residuo tau_cmd - RNEA(q,dq,ddq) con Pinocchio, filtro de fase
    cero, ajuste por minimos cuadrados sobre las mesetas de velocidad constante
    del barrido de excitacion, validacion cruzada dejando fuera niveles de
    velocidad completos, y bandas de confianza.
  </description>
  <maintainer email="smorales@utec.edu.pe">Sergio Morales</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-scipy</exec_depend>
  <exec_depend>python3-matplotlib</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>ur5_kinematics</exec_depend>
  <exec_depend>ur5_dyn_control</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>controller_manager_msgs</exec_depend>
  <exec_depend>ur_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
